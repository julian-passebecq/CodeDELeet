{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data Practice Studio content pack v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "version",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 199
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
    },
    "text": {
      "type": "string",
      "maxLength": 30000
    },
    "textList": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 15000
      }
    },
    "question": {
      "type": "object",
      "required": [
        "title",
        "topic",
        "language",
        "summary",
        "task",
        "starter",
        "solution",
        "explanation",
        "id",
        "version",
        "workspace",
        "engine",
        "difficulty",
        "minutes",
        "concept",
        "requirements",
        "hints",
        "sources"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/text"
        },
        "topic": {
          "$ref": "#/$defs/text"
        },
        "language": {
          "$ref": "#/$defs/text"
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "task": {
          "$ref": "#/$defs/text"
        },
        "starter": {
          "$ref": "#/$defs/text"
        },
        "solution": {
          "$ref": "#/$defs/text"
        },
        "explanation": {
          "$ref": "#/$defs/text"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "workspace": {
          "enum": [
            "code",
            "model",
            "pipeline",
            "architecture"
          ]
        },
        "engine": {
          "enum": [
            "sql",
            "python",
            "dax-subset",
            "graph",
            "review"
          ]
        },
        "difficulty": {
          "enum": [
            "Easy",
            "Medium",
            "Hard"
          ]
        },
        "minutes": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 240
        },
        "concept": {
          "$ref": "#/$defs/textList"
        },
        "requirements": {
          "$ref": "#/$defs/textList"
        },
        "hints": {
          "$ref": "#/$defs/textList"
        },
        "rubric": {
          "$ref": "#/$defs/textList"
        },
        "sources": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "label",
              "url"
            ],
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 299
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://",
                "maxLength": 1999
              }
            }
          }
        },
        "template": {
          "type": "string"
        },
        "dataset": {
          "type": "string"
        },
        "entrypoint": {
          "type": "string"
        },
        "expectedGrain": {
          "type": "string"
        },
        "ordered": {
          "type": "boolean"
        },
        "pythonTests": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": [
              "args",
              "expected",
              "label"
            ],
            "properties": {
              "args": {
                "type": "array"
              },
              "expected": {},
              "label": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
