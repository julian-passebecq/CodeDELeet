{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeDELeet portable content pack envelope",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "version",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 199
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "title",
          "workspace",
          "topic",
          "difficulty",
          "minutes",
          "engine",
          "language",
          "summary",
          "concept",
          "task",
          "requirements",
          "starter",
          "solution",
          "explanation",
          "hints",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "workspace": {
            "enum": [
              "code",
              "model",
              "pipeline",
              "architecture"
            ]
          },
          "engine": {
            "enum": [
              "sql",
              "python",
              "dax-subset",
              "graph",
              "review"
            ]
          },
          "executionMode": {
            "enum": [
              "execute",
              "analyze",
              "simulate",
              "review",
              "external"
            ]
          },
          "renderer": {
            "enum": [
              "architecture-editor",
              "code-editor",
              "concept-case",
              "config-editor",
              "dag-editor",
              "git-visual",
              "multi-choice-reasoning",
              "performance-investigation",
              "pipeline-investigation",
              "pyspark-editor",
              "semantic-model",
              "sql-editor",
              "terminal"
            ]
          },
          "difficulty": {
            "enum": [
              "Easy",
              "Medium",
              "Hard"
            ]
          },
          "minutes": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 240
          }
        }
      }
    }
  }
}
