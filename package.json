{
  "name": "codedeleet-v2",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "CodeDELeet - local-first data engineering interview workstation",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build && node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:ui": "python tests/ui_smoke.py",
    "test:fixtures": "python tests/fixture_check.py",
    "preview": "node scripts/serve.mjs dist",
    "test:network": "python tests/network_runtime_smoke.py",
    "test:shell": "python tests/v22_ui.py",
    "test:integrity": "python scripts/validate_release.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
